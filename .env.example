# =====================================================
# AI Assistant — Environment Configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file.
# =====================================================

# --- App URLs ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=

# --- Database (PostgreSQL) ---
# Local docker-compose default. Replace with your managed Postgres URL in production
# (e.g. Supabase, Neon, Railway, AWS RDS).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_assistant

# --- JWT / Sessions ---
# Generate strong secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_random_32+_character_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_32+_character_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# --- OAuth (optional — leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (required for verification / password reset to actually send) ---
# Example: Gmail SMTP, SendGrid, Postmark, AWS SES, Mailgun, etc.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@yourapp.com

# --- AI Provider (required for chat to work) ---
# Set to "openai", "anthropic", or "none"
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- File Storage ---
# "local" stores files on disk (fine for single-server deployments/dev).
# "s3" requires the S3 fields below.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# --- Redis (optional, for distributed rate limiting across multiple server instances) ---
REDIS_URL=

# =====================================================
# Frontend (frontend/.env)
# =====================================================
# VITE_API_URL=http://localhost:4000
